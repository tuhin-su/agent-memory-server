POSTGRES_PASSWORD=change-me
ADMIN_TOKEN=change-me-to-a-long-random-string

# API listen address
API_HOST=0.0.0.0
API_PORT=8080

# Data storage — choose ONE style:
#   Named Docker volume (auto-managed):  DATA_VOLUME=memdata
#   Absolute host path (bind-mount):     DATA_VOLUME=/home/you/mydata
#   Relative host path (bind-mount):     DATA_VOLUME=./data
DATA_VOLUME=memdata

# Embedding
EMBED_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Optional tuning
MAX_FILE_BYTES=2000000
